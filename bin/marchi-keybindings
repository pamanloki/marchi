#!/usr/bin/env bash
# Searchable keybinding cheat sheet, parsed from the niri config, shown in fuzzel.
set -euo pipefail
conf="$HOME/.config/niri/config.kdl"
[ -f "$conf" ] || { notify-send -a marchi "Keybindings" "niri config not found" 2>/dev/null; exit 1; }

# Pull lines that look like binds (inside the binds {} block) and format them as
# "KEYS   →   description/action".
awk '
  /^[[:space:]]*binds[[:space:]]*\{/ { inbinds=1; next }
  inbinds && /^[[:space:]]*\}[[:space:]]*$/ { inbinds=0 }
  inbinds {
    line=$0
    sub(/^[[:space:]]+/, "", line)
    if (line ~ /^\/\// || line == "") next
    if (line !~ /\{/) next
    # keys = text before first { or whitespace-property
    keys=line
    sub(/[[:space:]]*(hotkey-overlay-title|repeat|cooldown-ms|allow-when-locked|allow-inhibiting).*/, "", keys)
    sub(/[[:space:]]*\{.*/, "", keys)
    # description: prefer hotkey-overlay-title, else the action in braces
    desc=""
    if (match(line, /hotkey-overlay-title="[^"]*"/)) {
      desc=substr(line, RSTART, RLENGTH)
      sub(/hotkey-overlay-title="/, "", desc); sub(/"$/, "", desc)
    } else if (match(line, /\{[^}]*\}/)) {
      desc=substr(line, RSTART+1, RLENGTH-2)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", desc)
      sub(/;.*/, "", desc)
    }
    if (keys != "" && desc != "")
      printf "%-28s  %s\n", keys, desc
  }
' "$conf" | fuzzel --dmenu --prompt "keys " --width 70 --lines 20 >/dev/null 2>&1 || true
