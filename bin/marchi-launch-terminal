#!/usr/bin/env bash
# marchi-launch-terminal [command...]
# Opens the preferred terminal ($MARCHI_TERMINAL or foot). Any arguments are
# run as a command inside it.
set -euo pipefail
term="${MARCHI_TERMINAL:-foot}"
if [ $# -gt 0 ]; then
  case "$term" in
    foot)                exec "$term" "$@" ;;            # foot takes the command directly
    alacritty|kitty|ghostty) exec "$term" -e "$@" ;;
    *)                   exec "$term" -e "$@" ;;
  esac
else
  exec "$term"
fi
