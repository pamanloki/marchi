#!/usr/bin/env bash
# marchi-theme-set <theme-name>
#
# Reads themes/<name>/colors.sh (the single source of truth for a palette) and
# generates every derived config into the marchi state dir, then live-reloads
# the running apps. Config files deployed to ~/.config point at these generated
# files, so switching themes is instant and consistent across the desktop.
set -euo pipefail

MARCHI_CONFIG="${MARCHI_CONFIG:-$HOME/.config/marchi}"
MARCHI_THEMES="$MARCHI_CONFIG/themes"
MARCHI_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/marchi"
CURRENT="$MARCHI_STATE/current"
THEME_OUT="$CURRENT/theme"

die() { echo "marchi-theme-set: $*" >&2; exit 1; }

[ $# -ge 1 ] || die "usage: marchi-theme-set <theme-name>"
theme="$1"
themedir="$MARCHI_THEMES/$theme"
[ -d "$themedir" ] || die "no such theme: $theme (looked in $MARCHI_THEMES)"
[ -f "$themedir/colors.sh" ] || die "theme '$theme' has no colors.sh"

# shellcheck source=/dev/null
source "$themedir/colors.sh"

mkdir -p "$THEME_OUT"

# --- alacritty ---------------------------------------------------------------
cat >"$THEME_OUT/alacritty.toml" <<EOF
# generated by marchi-theme-set ($name)
[colors.primary]
background = "$background"
foreground = "$foreground"

[colors.cursor]
text = "$background"
cursor = "$cursor"

[colors.selection]
background = "$selection"
text = "$foreground"

[colors.normal]
black = "$black"
red = "$red"
green = "$green"
yellow = "$yellow"
blue = "$blue"
magenta = "$magenta"
cyan = "$cyan"
white = "$white"

[colors.bright]
black = "$bright_black"
red = "$bright_red"
green = "$bright_green"
yellow = "$bright_yellow"
blue = "$bright_blue"
magenta = "$bright_magenta"
cyan = "$bright_cyan"
white = "$bright_white"
EOF

# --- waybar ------------------------------------------------------------------
cat >"$THEME_OUT/waybar.css" <<EOF
/* generated by marchi-theme-set ($name) */
@define-color background $background;
@define-color foreground $foreground;
@define-color accent     $accent;
@define-color muted      $muted;
@define-color red        $red;
@define-color green      $green;
@define-color yellow     $yellow;
EOF

# --- mako --------------------------------------------------------------------
cat >"$THEME_OUT/mako.ini" <<EOF
# generated by marchi-theme-set ($name)
font=JetBrainsMono Nerd Font 10
background-color=$background
text-color=$foreground
border-color=$accent
progress-color=over $selection
border-size=2
border-radius=8
padding=12
margin=8
default-timeout=5000
anchor=top-right
max-visible=5

[urgency=high]
border-color=$red

[urgency=low]
border-color=$muted
EOF

# --- swaylock ----------------------------------------------------------------
strip() { printf '%s' "${1#\#}"; }
cat >"$THEME_OUT/swaylock.conf" <<EOF
# generated by marchi-theme-set ($name)
ignore-empty-password
indicator-radius=100
indicator-thickness=8
color=$(strip "$background_dark")
inside-color=$(strip "$background")
ring-color=$(strip "$muted")
key-hl-color=$(strip "$accent")
line-color=00000000
separator-color=00000000
text-color=$(strip "$foreground")
inside-clear-color=$(strip "$background")
ring-clear-color=$(strip "$yellow")
inside-ver-color=$(strip "$background")
ring-ver-color=$(strip "$accent")
inside-wrong-color=$(strip "$background")
ring-wrong-color=$(strip "$red")
text-wrong-color=$(strip "$red")
EOF

# --- fuzzel ------------------------------------------------------------------
cat >"$THEME_OUT/fuzzel.ini" <<EOF
# generated by marchi-theme-set ($name)
[main]
font=JetBrainsMono Nerd Font:size=11
prompt=" "
icon-theme=Papirus-Dark
terminal=marchi-launch-terminal
lines=10
width=45
horizontal-pad=20
vertical-pad=14
inner-pad=8

[border]
width=2
radius=10

[colors]
background=$(strip "$background")ee
text=$(strip "$foreground")ff
match=$(strip "$accent")ff
selection=$(strip "$selection")ff
selection-text=$(strip "$foreground")ff
selection-match=$(strip "$accent")ff
border=$(strip "$accent")ff
prompt=$(strip "$accent")ff
input=$(strip "$foreground")ff
EOF

# --- niri colors (patch the deployed config in place) ------------------------
niri_config="$HOME/.config/niri/config.kdl"
if [ -f "$niri_config" ]; then
  # Replace the value on lines tagged with our markers. GNU sed.
  sed -i -E \
    -e "s|(active-color \")[^\"]*(\"[[:space:]]*// marchi:accent)|\1${accent}\2|g" \
    -e "s|(inactive-color \")[^\"]*(\"[[:space:]]*// marchi:muted)|\1${muted}\2|g" \
    "$niri_config"
fi
# Keep a copy for reference / re-apply.
cat >"$THEME_OUT/niri-colors.kdl" <<EOF
// generated by marchi-theme-set ($name)
// focus-ring/border active-color = $accent
// focus-ring/border inactive-color = $muted
EOF

# --- record + copy palette ---------------------------------------------------
cp "$themedir/colors.sh" "$THEME_OUT/colors.sh"
printf '%s\n' "$theme" >"$CURRENT/theme.name"
printf '%s\n' "$name"  >"$CURRENT/theme.title"

# Point the current-theme symlink at the source theme dir (for backgrounds etc).
ln -sfn "$themedir" "$CURRENT/source"

# --- reload live apps --------------------------------------------------------
pkill -SIGUSR2 waybar 2>/dev/null || true
command -v makoctl >/dev/null 2>&1 && makoctl reload 2>/dev/null || true
command -v marchi-wallpaper >/dev/null 2>&1 && marchi-wallpaper >/dev/null 2>&1 || true
# niri and alacritty live-reload their config files automatically.

echo "marchi: theme set to $name"
command -v notify-send >/dev/null 2>&1 && notify-send -a marchi "Theme" "Switched to $name" || true
