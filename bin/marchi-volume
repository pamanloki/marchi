#!/usr/bin/env bash
# marchi-volume up|down|mute|mic-mute  (PipeWire via wpctl)
set -euo pipefail
SINK="@DEFAULT_AUDIO_SINK@"
SRC="@DEFAULT_AUDIO_SOURCE@"
case "${1:-}" in
  up)       wpctl set-volume "$SINK" 5%+ -l 1.5 ;;
  down)     wpctl set-volume "$SINK" 5%- ;;
  mute)     wpctl set-mute "$SINK" toggle ;;
  mic-mute) wpctl set-mute "$SRC" toggle ;;
  *) echo "usage: marchi-volume up|down|mute|mic-mute" >&2; exit 1 ;;
esac
# Nudge waybar to refresh immediately.
pkill -SIGRTMIN+1 waybar 2>/dev/null || true
