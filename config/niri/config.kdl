// marchi :: niri configuration
// An Omarchy-inspired setup for Void Linux, using niri instead of Hyprland.
//
// niri is a scrollable-tiling Wayland compositor, so the window model differs
// from Hyprland's dwindle layout. Where possible the keybindings mirror
// Omarchy's muscle memory (SUPER as the modifier, SUPER+Return for a terminal,
// SUPER+Q to close, SUPER+1..0 for workspaces), adapted to niri's columns.
//
// Docs: https://yalter.github.io/niri/
// Reload: niri reloads this file automatically when it changes.

input {
    keyboard {
        xkb {
            // Leave empty to inherit from localectl (localectl set-x11-keymap).
            // Example: layout "us,de"; options "grp:alts_toggle,compose:caps"
            options "compose:caps"
        }
        numlock
    }

    touchpad {
        tap
        natural-scroll
        click-method "clickfinger"
        // dwt          // disable-while-typing
        // accel-speed 0.2
    }

    mouse {
        // accel-speed 0.0
    }

    // Focus follows the mouse only for windows already fully on screen.
    // focus-follows-mouse max-scroll-amount="0%"

    // Warp the mouse to newly focused windows (comment out if annoying).
    // warp-mouse-to-focus
}

// Configure outputs by name (see `niri msg outputs`).
// Uncomment and edit for a fixed resolution / scale / position.
/-output "eDP-1" {
    mode "1920x1080@60.000"
    scale 1.0
    transform "normal"
    position x=0 y=0
}

layout {
    gaps 10
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 2
        active-color "#7aa2f7"   // marchi:accent
        inactive-color "#414868" // marchi:muted
    }

    border {
        off
        width 2
        active-color "#7aa2f7"   // marchi:accent
        inactive-color "#414868" // marchi:muted
    }

    shadow {
        // on
        softness 20
        spread 4
        offset x=0 y=4
        color "#00000055"
    }

    struts {
        // Give the top a little breathing room for the bar if needed.
    }
}

// -----------------------------------------------------------------------------
// Startup
// -----------------------------------------------------------------------------
spawn-at-startup "waybar"
spawn-at-startup "mako"
spawn-at-startup "marchi-wallpaper"
spawn-at-startup "marchi-idle"
spawn-sh-at-startup "wl-paste --type text --watch cliphist store"
spawn-sh-at-startup "wl-paste --type image --watch cliphist store"
// Polkit authentication agent (installed by marchi). Falls back silently.
spawn-at-startup "marchi-polkit-agent"
// Tell systemd/dbus activation environment about the session (for portals).
spawn-at-startup "dbus-update-activation-environment" "--systemd" "WAYLAND_DISPLAY" "XDG_CURRENT_DESKTOP" "NIRI_SOCKET"

hotkey-overlay {
    // skip-at-startup
}

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

environment {
    // Force Wayland everywhere it is safe to.
    GDK_BACKEND "wayland,x11"
    QT_QPA_PLATFORM "wayland;xcb"
    QT_QPA_PLATFORMTHEME "gtk3"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
    MOZ_ENABLE_WAYLAND "1"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    _JAVA_AWT_WM_NONREPARENTING "1"
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_TYPE "wayland"
    DISPLAY ":0"
}

animations {
    // off
    slowdown 1.0
}

// -----------------------------------------------------------------------------
// Window rules
// -----------------------------------------------------------------------------
window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
}

// Picture-in-Picture floats.
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}
window-rule {
    match title="^Picture in picture$"
    open-floating true
}

// Common dialogs float.
window-rule {
    match app-id=r#"^(pavucontrol|blueman-manager|nm-connection-editor)$"#
    open-floating true
}

// Password managers blocked from screen capture.
window-rule {
    match app-id=r#"^(org\.keepassxc\.KeePassXC|Bitwarden|1Password)$"#
    block-out-from "screen-capture"
}

// -----------------------------------------------------------------------------
// Keybindings (SUPER = Mod)
// -----------------------------------------------------------------------------
binds {
    // --- Help ---
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+K hotkey-overlay-title="Keybindings cheat sheet" { spawn "marchi-keybindings"; }

    // --- Applications ---
    Mod+Return hotkey-overlay-title="Terminal" { spawn "marchi-launch-terminal"; }
    Mod+Shift+Return hotkey-overlay-title="Browser" { spawn "marchi-launch-browser"; }
    Mod+Shift+B hotkey-overlay-title="Browser" { spawn "marchi-launch-browser"; }
    Mod+E hotkey-overlay-title="File manager" { spawn "marchi-launch-filemanager"; }
    Mod+Shift+N hotkey-overlay-title="Editor" { spawn "marchi-launch-editor"; }
    Mod+Shift+M hotkey-overlay-title="Activity monitor" { spawn "marchi-launch-terminal" "btop"; }

    // --- Menus / launchers ---
    Mod+Space hotkey-overlay-title="Application launcher" { spawn "fuzzel"; }
    Mod+Escape hotkey-overlay-title="Power / system menu" { spawn "marchi-menu"; }
    Mod+Alt+Space hotkey-overlay-title="Power / system menu" { spawn "marchi-menu"; }
    Mod+Ctrl+Space hotkey-overlay-title="Wallpaper switcher" { spawn "marchi-wallpaper" "--menu"; }
    Mod+Ctrl+Shift+Space hotkey-overlay-title="Theme switcher" { spawn "marchi-theme-menu"; }
    Mod+Ctrl+E hotkey-overlay-title="Emoji picker" { spawn-sh "fuzzel --dmenu --prompt 'emoji '  < ~/.local/share/marchi/emoji.txt | cut -d' ' -f1 | wl-copy"; }
    Mod+V hotkey-overlay-title="Clipboard history" { spawn "marchi-clipboard"; }

    // --- Window management ---
    Mod+Q repeat=false { close-window; }
    Mod+W repeat=false { close-window; }

    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }
    Mod+K     { focus-window-up; }
    Mod+J     { focus-window-down; }

    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+H     { move-column-left; }
    Mod+Shift+L     { move-column-right; }
    Mod+Shift+K     { move-window-up; }
    Mod+Shift+J     { move-window-down; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }

    // Monitors.
    Mod+Ctrl+Shift+Left  { focus-monitor-left; }
    Mod+Ctrl+Shift+Right { focus-monitor-right; }
    Mod+Ctrl+Shift+Up    { focus-monitor-up; }
    Mod+Ctrl+Shift+Down  { focus-monitor-down; }

    // Column / window sizing.
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }
    Mod+C { center-column; }

    // Fullscreen / maximize (Omarchy: F = fullscreen, Alt+F = full width).
    Mod+F { fullscreen-window; }
    Mod+Alt+F { maximize-column; }
    Mod+Ctrl+F { expand-column-to-available-width; }

    // Floating & tabbed.
    Mod+T { toggle-window-floating; }
    Mod+Shift+T { switch-focus-between-floating-and-tiling; }
    Mod+Shift+W { toggle-column-tabbed-display; }

    // Consume / expel windows into columns (core scrollable-tiling moves).
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }

    // Overview (zoomed-out view of all workspaces).
    Mod+O repeat=false { toggle-overview; }

    // --- Workspaces ---
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+Shift+0 { move-column-to-workspace 10; }

    Mod+Tab { focus-workspace-previous; }
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up   { focus-workspace-up; }
    Mod+U         { focus-workspace-down; }
    Mod+I         { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }

    // Mouse-wheel workspace scrolling (Omarchy: SUPER + scroll).
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }
    Mod+WheelScrollRight { focus-column-right; }
    Mod+WheelScrollLeft  { focus-column-left; }

    // --- Notifications (mako) ---
    Mod+Backspace { spawn "makoctl" "dismiss"; }
    Mod+Shift+Backspace { spawn "makoctl" "dismiss" "--all"; }
    Mod+Ctrl+Backspace { spawn "makoctl" "restore"; }

    // --- Screenshots (niri built-in) ---
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    // --- System ---
    Mod+Ctrl+L { spawn "marchi-lock"; }
    Mod+Ctrl+I { spawn "marchi-idle" "--toggle"; }
    Mod+Ctrl+N { spawn "marchi-nightlight" "--toggle"; }

    // Audio (PipeWire / WirePlumber).
    XF86AudioRaiseVolume allow-when-locked=true { spawn "marchi-volume" "up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "marchi-volume" "down"; }
    XF86AudioMute        allow-when-locked=true { spawn "marchi-volume" "mute"; }
    XF86AudioMicMute     allow-when-locked=true { spawn "marchi-volume" "mic-mute"; }

    // Media (playerctl / MPRIS).
    XF86AudioPlay  allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPause allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext  allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev  allow-when-locked=true { spawn "playerctl" "previous"; }

    // Brightness (brightnessctl).
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+5%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "5%-"; }

    // Keyboard shortcut inhibitor escape hatch.
    Mod+Shift+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // Power off monitors.
    Mod+Shift+P { power-off-monitors; }

    // Quit niri (asks for confirmation).
    Mod+Shift+E { quit; }
}
