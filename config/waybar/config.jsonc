// marchi :: waybar
// A single top bar, Omarchy-flavoured, wired to niri's own modules.
{
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 26,
  "margin-top": 6,
  "margin-left": 10,
  "margin-right": 10,

  "modules-left": [
    "custom/menu",
    "niri/workspaces",
    "niri/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "tray",
    "mpris",
    "network",
    "bluetooth",
    "pulseaudio",
    "backlight",
    "battery",
    "custom/notifications"
  ],

  "custom/menu": {
    "format": "󰣇",
    "tooltip-format": "marchi menu",
    "on-click": "marchi-menu",
    "on-click-right": "marchi-theme-menu"
  },

  "niri/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": "",
      "default": ""
    }
  },

  "niri/window": {
    "format": "{}",
    "max-length": 60,
    "separate-outputs": true
  },

  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "format-alt": "{:%Y-%m-%d %H:%M:%S}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#ffffff'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b>{}</b></span>"
      }
    },
    "on-click": "marchi-launch-terminal cal -3"
  },

  "mpris": {
    "format": "{player_icon} {dynamic}",
    "format-paused": "{status_icon} <i>{dynamic}</i>",
    "player-icons": { "default": "▶", "spotify": "" },
    "status-icons": { "paused": "" },
    "max-length": 40,
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next"
  },

  "tray": {
    "icon-size": 15,
    "spacing": 8
  },

  "network": {
    "format-wifi": "  {signalStrength}%",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤭",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "marchi-menu network"
  },

  "bluetooth": {
    "format": "",
    "format-disabled": "󰂲",
    "format-connected": " {num_connections}",
    "tooltip-format": "{controller_alias}\n{num_connections} connected",
    "on-click": "blueman-manager"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "format-icons": {
      "headphone": "",
      "default": ["", "", ""]
    },
    "scroll-step": 5,
    "on-click": "marchi-volume mute",
    "on-click-right": "pavucontrol"
  },

  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": ["", "", "", "", "", "", "", "", ""],
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set 5%-"
  },

  "battery": {
    "states": { "warning": 30, "critical": 15 },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-icons": ["", "", "", "", ""],
    "tooltip-format": "{timeTo} ({power}W)"
  },

  "custom/notifications": {
    "format": "󰂚",
    "tooltip-format": "Notifications\nleft: history · right: dismiss all",
    "on-click": "makoctl restore",
    "on-click-right": "makoctl dismiss --all"
  }
}
